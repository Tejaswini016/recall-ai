# Root environment file consumed by docker-compose.yml.
# Copy to .env and fill in the blanks. Never commit .env.

POSTGRES_DB=recallai
POSTGRES_USER=recallai
POSTGRES_PASSWORD=change-me
# Host port for the compose Postgres. Use e.g. 5433 if PostgreSQL is already installed locally.
POSTGRES_PORT=5432

JWT_SECRET=
JWT_EXPIRATION_MINUTES=1440

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-5

AI_PROVIDER=anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_DEMO_MODE=false

CORS_ALLOWED_ORIGINS=http://localhost:3000
AI_RATE_LIMIT=20
SWAGGER_ENABLED=true

NEXT_PUBLIC_API_URL=http://localhost:8080
