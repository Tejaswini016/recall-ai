# --- Database ---
DATABASE_URL=jdbc:postgresql://localhost:5432/recallai
DATABASE_USERNAME=recallai
DATABASE_PASSWORD=change-me

# --- Security ---
# Base64-encoded 256-bit (or longer) HMAC secret. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=1440

# --- Claude AI ---
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- HTTP ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE=10MB

# --- Rate limiting (AI generation requests per user per hour) ---
AI_RATE_LIMIT=20

# --- Logging ---
LOG_LEVEL=INFO
