# --- Database ---
DATABASE_URL=jdbc:postgresql://localhost:5432/recallai
DATABASE_USERNAME=recallai
DATABASE_PASSWORD=change-me

# --- Security ---
# Base64-encoded 256-bit (or longer) HMAC secret. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=1440

# --- Claude AI ---
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- HTTP ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE=10MB
# Largest extracted study text per generation and the number of model-sized chunks it may span
MATERIAL_MAX_CHARS=60000
MATERIAL_MAX_CHUNKS=6

# --- Weak-topic detection (deterministic rule over review history) ---
WEAK_TOPIC_MIN_REVIEWS=3
WEAK_TOPIC_QUALITY_THRESHOLD=3.0
WEAK_TOPIC_RECENT_WINDOW=10

# --- Provider selection ---
# anthropic (default) or gemini. Gemini Flash models have a free developer tier (key from Google AI Studio).
AI_PROVIDER=anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# true = local heuristic generator, no key, not AI (for demos only)
AI_DEMO_MODE=false

# --- Rate limiting (AI generation requests per user per hour) ---
AI_RATE_LIMIT=20

# --- Logging ---
LOG_LEVEL=INFO

# --- Production toggles ---
# Set to false to hide Swagger UI and the OpenAPI document.
SWAGGER_ENABLED=true
